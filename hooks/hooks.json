{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*autodesk-fusion__fusion_mcp_execute|.*fusion-cad__execute|^(Write|Edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/fusion_kit_nudge.py\""
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/fusion_kit_brief_guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*autodesk-fusion__fusion_mcp_execute|.*fusion-cad__execute",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/dfam_guard.py\""
          }
        ]
      },
      {
        "matcher": ".*autodesk-fusion__fusion_mcp_execute|.*fusion-cad__execute|^(Agent|Write|Edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/cad_simplify_nudge.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/dfam_guard.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/cad_simplify_nudge.py\""
          }
        ]
      }
    ]
  }
}
